{
  "voice": "zh_female_cancan_mars_bigtts",
  "style": "volc.apikey",
  "scenes": {
    "intro": [
      {
        "text": "你懂点积和矩阵，但机器怎么学会该用哪种变换？",
        "dur": 4.968
      },
      {
        "text": "感知机是最简单的学习机器：加权、求和、决策，然后调整。",
        "dur": 7.368
      },
      {
        "text": "每一个神经网络，都是把这个想法一层层叠起来的产物。",
        "dur": 4.752
      }
    ],
    "neuron": [
      {
        "text": "感知机接收 n 个输入，每个乘上一个权重。",
        "dur": 4.272
      },
      {
        "text": "全部加起来，再补上一个偏置。",
        "dur": 3.264
      },
      {
        "text": "送进激活函数，输出 0 或 1——这就是一次决策。",
        "dur": 5.664
      }
    ],
    "weighted": [
      {
        "text": "AND 门实测：第 4 轮收敛。",
        "dur": 3.24
      },
      {
        "text": "权重 w = [0.2, 0.1]，偏置 b = -0.2。",
        "dur": 6.12
      },
      {
        "text": "权重缩放每个输入的贡献，偏置平移判断的门槛。",
        "dur": 4.968
      }
    ],
    "step": [
      {
        "text": "加权和加偏置大于等于 0，就输出 1；否则输出 0。",
        "dur": 6.864
      },
      {
        "text": "没有中间状态，决策干净利落。",
        "dur": 3.552
      },
      {
        "text": "它不可导——为后面换 sigmoid 埋下伏笔。",
        "dur": 4.272
      }
    ],
    "boundary": [
      {
        "text": "两个输入时，感知机在平面上画出一条直线。",
        "dur": 4.368
      },
      {
        "text": "w1·x1 + w2·x2 + b = 0 就是这条边界。",
        "dur": 7.56
      },
      {
        "text": "一侧全 0、一侧全 1；训练就是挪这条线。",
        "dur": 4.536
      }
    ],
    "rule": [
      {
        "text": "预测正确，误差为 0，什么都不动。",
        "dur": 3.624
      },
      {
        "text": "预测成 0 但应为 1，权重增大；方向反了就减小。",
        "dur": 6.144
      },
      {
        "text": "w += lr · error · x——学习就是不断调整数字。",
        "dur": 6.816
      }
    ],
    "or": [
      {
        "text": "OR 门实测：第 4 轮收敛，四个输入全对。",
        "dur": 4.416
      },
      {
        "text": "学到的权重 [0.1, 0.1]，偏置 -0.1。",
        "dur": 5.856
      },
      {
        "text": "AND、NOT 同样几轮收敛——线性可分问题手到擒来。",
        "dur": 6.096
      }
    ],
    "xor": [
      {
        "text": "XOR 的四个点，任何一条直线都分不开。",
        "dur": 4.368
      },
      {
        "text": "实测：训练 1000 轮不收敛，两例预测错误。",
        "dur": 4.944
      },
      {
        "text": "1969 年 Minsky 证明此限制，研究几乎停滞十年。",
        "dur": 5.568
      }
    ],
    "hidden": [
      {
        "text": "诀窍：XOR = (x1 OR x2) AND NOT (x1 AND x2)。",
        "dur": 7.728
      },
      {
        "text": "三个感知机组两层，权重手工设好。",
        "dur": 4.056
      },
      {
        "text": "实测四种输入全部正确——直线叠出曲线。",
        "dur": 4.56
      }
    ],
    "sigmoid": [
      {
        "text": "阶跃换成 sigmoid，梯度存在，误差可反向传播。",
        "dur": 5.4
      },
      {
        "text": "实测总误差从 1.2164 一路降到 0.0003。",
        "dur": 5.904
      },
      {
        "text": "输出 0.0074 / 0.9923 / 0.9923 / 0.0094，四种全对。",
        "dur": 8.352
      }
    ],
    "code": [
      {
        "text": "核心只有三十行：predict 与 train 两个方法。",
        "dur": 4.56
      },
      {
        "text": "预测是点积加偏置过阶跃；训练按误差调权重。",
        "dur": 5.352
      },
      {
        "text": "sklearn 的 Perceptron 做同一件事，差距在规模。",
        "dur": 4.656
      }
    ],
    "recap": [
      {
        "text": "输入 → 加权求和 → 激活 → 决策。",
        "dur": 3.48
      },
      {
        "text": "单个感知机只能画直线，叠起来才能画任意形状。",
        "dur": 5.28
      },
      {
        "text": "权重、偏置、线性可分、多层——这门课的地基。",
        "dur": 5.472
      }
    ]
  }
}
